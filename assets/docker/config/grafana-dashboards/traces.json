{
  "uid": "intranet-traces",
  "title": "Intranet - Traces",
  "tags": ["intranet", "traces", "tempo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "tempo",
      "title": "Service Graph",
      "gridPos": {"h": 12, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "datasource": {"type": "tempo", "uid": "tempo"},
      "targets": [
        {"refId": "A", "queryType": "serviceMap", "serviceMapQuery": "{resource.service.name=~\".+\"}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Traces por Serviço",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "id": 2,
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {"refId": "A", "queryType": "range", "expr": "count_over_time({service_name=~\"$service\"}[$__interval])", "legendFormat": "{{service_name}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Latência Média por Serviço (s)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "id": 3,
      "datasource": {"type": "prometheus", "uid": "mim"},
      "targets": [
        {"refId": "A", "expr": "sum by (service_name) (rate(traces_spanmetrics_duration_seconds_sum[$__rate_interval])) / sum by (service_name) (rate(traces_spanmetrics_duration_seconds_count[$__rate_interval]))", "legendFormat": "{{service_name}}"}
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Serviço",
        "type": "query",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": "label_values({service_name=~\".+\"}, service_name)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {"selected": true, "text": "All", "value": "$__all"}
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"}
}
